# Base URL of the SkillSwap backend REST API (must include /api)
VITE_API_URL=http://localhost:5000/api

# Base URL of the SkillSwap backend Socket.IO server (no /api suffix)
VITE_SOCKET_URL=http://localhost:5000

# Active payment provider. Backend currently ships "mock"; set to "razorpay"
# once the backend PAYMENT_PROVIDER env var is switched and keys are configured.
VITE_PAYMENT_PROVIDER=mock
